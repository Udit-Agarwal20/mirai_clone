# Application Environment Configuration
NODE_ENV=production
PORT=3000

# MongoDB Database Connection String (e.g. MongoDB Atlas)
# Format: mongodb+srv://<username>:<password>@<cluster-url>/nova_institute?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_user:your_password@your_cluster.mongodb.net/nova_institute?retryWrites=true&w=majority

# Express Session Encryption Secret (Use a long, cryptographically random string in production)
SESSION_SECRET=your_super_secret_random_session_key_here

# Optional: Initial Administrator Account Credentials for Seeding (scripts/seed.js)
ADMIN_EMAIL=admin@novatech.edu
ADMIN_PASSWORD=your_secure_admin_password_here
