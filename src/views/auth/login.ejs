<div class="section" style="min-height: 75vh; display: flex; align-items: center;">
  <div class="container" style="max-width: 480px;">
    <div class="card" style="padding: 2.5rem;">
      <div class="text-center" style="margin-bottom: 2rem;">
        <div class="brand-mark" style="margin: 0 auto 1rem; width: 44px; height: 44px; font-size: 1.25rem;">N</div>
        <h1 style="font-size: 1.85rem; margin-bottom: 0.5rem;">Sign In</h1>
        <p style="font-size: 0.875rem; color: var(--text-secondary);">
          Access your applicant portal or administrative dashboard.
        </p>
      </div>

      <form action="/auth/login" method="POST">
        <div class="form-group">
          <label class="form-label" for="loginEmail">Email Address</label>
          <input type="email" id="loginEmail" name="email" class="form-control" placeholder="name@example.com" required value="<%= formData.email || '' %>">
        </div>

        <div class="form-group">
          <label class="form-label" for="loginPassword">Password</label>
          <input type="password" id="loginPassword" name="password" class="form-control" placeholder="••••••••" required>
        </div>

        <button type="submit" class="btn btn-primary btn-full btn-lg" style="margin-top: 0.5rem;">Sign In &rarr;</button>
      </form>

      <div style="margin-top: 1.75rem; padding-top: 1.5rem; border-top: 1px solid var(--border-light); font-size: 0.875rem; text-align: center; color: var(--text-secondary);">
        Don't have an applicant account? <a href="/auth/register" style="color: var(--accent-blue); font-weight: 600;">Create Account &rarr;</a>
      </div>

      <div style="margin-top: 1.25rem; background-color: var(--bg-subtle); padding: 0.75rem; border-radius: var(--radius-sm); font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-muted);">
        <div><strong>Demo Student:</strong> alex.rivers@example.com / Student@12345</div>
        <div style="margin-top: 0.25rem;"><strong>Demo Admin:</strong> admin@novatech.edu / Admin@Nova2026!</div>
      </div>
    </div>
  </div>
</div>
