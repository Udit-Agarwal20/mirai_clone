<div class="card card-hover" style="padding: 0; overflow: hidden;">
  <img src="<%= campus.image %>" alt="<%= campus.name %>" style="width: 100%; height: 220px; object-fit: cover;" loading="lazy">
  
  <div style="padding: 1.75rem; display: flex; flex-direction: column; flex: 1;">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.5rem;">
      <span class="badge badge-dark"><%= campus.city %></span>
      <span class="badge badge-success"><%= campus.status || 'Admissions Open' %></span>
    </div>

    <h3 style="font-size: 1.35rem; margin-bottom: 0.35rem;">
      <a href="/campuses/<%= campus.slug %>"><%= campus.name %></a>
    </h3>

    <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted); margin-bottom: 1rem;">
      <%= campus.tagline %>
    </div>

    <p style="font-size: 0.875rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 1.5rem; flex: 1;">
      <%= campus.description.substring(0, 130) %>...
    </p>

    <div style="padding-top: 1.25rem; border-top: 1px solid var(--border-light); display: flex; align-items: center; justify-content: space-between;">
      <div>
        <div style="font-size: 0.7rem; font-family: var(--font-mono); color: var(--text-muted);">HOSTEL FROM</div>
        <div style="font-weight: 700; font-family: var(--font-mono); font-size: 0.875rem;"><%= formatCurrency(campus.annualHostelFeeDefault) %>/yr</div>
      </div>
      <a href="/campuses/<%= campus.slug %>" class="btn btn-sm btn-secondary">Explore Campus &rarr;</a>
    </div>
  </div>
</div>
