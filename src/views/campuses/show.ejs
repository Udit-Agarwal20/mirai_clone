<div class="section-sm" style="background-color: var(--bg-surface); border-bottom: 1px solid var(--border-light);">
  <div class="container">
    <div style="font-family: var(--font-mono); font-size: 0.8125rem; color: var(--text-muted); margin-bottom: 0.75rem;">
      <a href="/">Home</a> / <a href="/campuses">Campuses</a> / <span style="color: var(--text-primary);"><%= campus.name %></span>
    </div>

    <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem;">
      <span class="badge badge-dark"><%= campus.city %>, <%= campus.state %></span>
      <span class="badge badge-success"><%= campus.status %></span>
      <span class="pill-tag"><%= campus.availableSeats %> Seats Available</span>
    </div>

    <h1 style="font-size: clamp(2.25rem, 4.5vw, 3.25rem); margin-bottom: 0.75rem;"><%= campus.name %></h1>
    <p class="lead" style="max-width: 820px; margin-bottom: 2rem;"><%= campus.tagline || campus.description %></p>

    <div style="display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;">
      <a href="/student/application" class="btn btn-primary btn-lg">Apply for <%= campus.city %> &rarr;</a>
      <a href="/contact" class="btn btn-secondary btn-lg">Schedule Campus Tour</a>
      <% if (isAuthenticated && isStudent) { %>
        <button type="button" class="btn btn-secondary" data-bookmark-btn data-item-type="campus" data-item-id="<%= campus._id %>">
          ★ Save Campus
        </button>
      <% } %>
    </div>
  </div>
</div>

<div class="section">
  <div class="container">
    <div class="grid grid-2-1" style="gap: 3rem; align-items: start;">
      <div>
        <img src="<%= campus.image %>" alt="<%= campus.name %>" style="width: 100%; border-radius: var(--radius-md); margin-bottom: 2.5rem; height: 380px; object-fit: cover;" loading="lazy">

        <div style="margin-bottom: 3.5rem;">
          <h2 style="font-size: 1.75rem; margin-bottom: 1rem;">Campus Overview</h2>
          <p style="font-size: 1.0625rem; color: var(--text-secondary); line-height: 1.7;">
            <%= campus.description %>
          </p>
        </div>

        <!-- Infrastructure & Facilities -->
        <% if (campus.facilities && campus.facilities.length > 0) { %>
          <div style="margin-bottom: 3.5rem;">
            <h2 style="font-size: 1.75rem; margin-bottom: 1.25rem;">Infrastructure & Facilities</h2>
            <div class="grid grid-2">
              <% campus.facilities.forEach(facility => { %>
                <div class="card" style="padding: 1.25rem; background-color: var(--bg-surface);">
                  <div style="font-size: 0.9375rem; font-weight: 600;">⚡ <%= facility %></div>
                </div>
              <% }) %>
            </div>
          </div>
        <% } %>

        <!-- Specialized Research Labs -->
        <% if (campus.labs && campus.labs.length > 0) { %>
          <div style="margin-bottom: 3.5rem;">
            <h2 style="font-size: 1.75rem; margin-bottom: 1.25rem;">Specialized Research & Hardware Labs</h2>
            <div class="grid grid-2">
              <% campus.labs.forEach(lab => { %>
                <div class="card" style="padding: 1.25rem; background-color: var(--bg-surface); border-left: 3px solid #000000;">
                  <div style="font-size: 0.9375rem; font-weight: 600;">🔬 <%= lab %></div>
                </div>
              <% }) %>
            </div>
          </div>
        <% } %>

        <!-- Hostel Accommodation Options -->
        <div style="margin-bottom: 3.5rem;">
          <h2 style="font-size: 1.75rem; margin-bottom: 1.25rem;">Hostel & Residential Accommodation</h2>
          
          <div style="display: flex; flex-direction: column; gap: 1.25rem;">
            <% if (campus.hostelOptions && campus.hostelOptions.length > 0) { %>
              <% campus.hostelOptions.forEach(hostel => { %>
                <div class="card" style="padding: 1.5rem; display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap;">
                  <div>
                    <h4 style="margin-bottom: 0.25rem;"><%= hostel.name %></h4>
                    <div style="font-size: 0.8125rem; color: var(--text-secondary); margin-bottom: 0.5rem;"><%= hostel.description %></div>
                    <div style="display: flex; gap: 0.5rem;">
                      <span class="badge badge-subtle"><%= hostel.roomType %></span>
                      <% if (hostel.mealsIncluded) { %>
                        <span class="badge badge-success">3 Meals Included</span>
                      <% } %>
                    </div>
                  </div>
                  <div>
                    <div style="font-family: var(--font-mono); font-size: 1.25rem; font-weight: 800; color: var(--text-primary);">
                      <%= formatCurrency(hostel.annualFee) %><span style="font-size: 0.75rem; font-weight: 400; color: var(--text-muted);">/yr</span>
                    </div>
                  </div>
                </div>
              <% }) %>
            <% } %>
          </div>
        </div>

        <!-- Programs Offered -->
        <% if (campus.programs && campus.programs.length > 0) { %>
          <div>
            <h2 style="font-size: 1.75rem; margin-bottom: 1.25rem;">Programs Offered at <%= campus.city %></h2>
            <div class="grid grid-2">
              <% campus.programs.forEach(program => { %>
                <div class="card" style="padding: 1.5rem;">
                  <h4 style="margin-bottom: 0.5rem;">
                    <a href="/programs/<%= program.slug %>"><%= program.name %></a>
                  </h4>
                  <p style="font-size: 0.8125rem; color: var(--text-secondary); margin-bottom: 1rem;"><%= program.shortDescription %></p>
                  <a href="/programs/<%= program.slug %>" class="btn btn-sm btn-secondary">Program Details &rarr;</a>
                </div>
              <% }) %>
            </div>
          </div>
        <% } %>
      </div>

      <!-- Campus Info Sidebar -->
      <aside>
        <div class="card" style="position: sticky; top: 6rem; padding: 2rem;">
          <h3 style="font-size: 1.35rem; margin-bottom: 1.25rem;">Campus Information</h3>

          <div style="display: flex; flex-direction: column; gap: 1.25rem; font-size: 0.875rem; margin-bottom: 1.5rem;">
            <div>
              <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted);">ADDRESS</div>
              <div style="color: var(--text-primary); margin-top: 0.25rem; line-height: 1.5;"><%= campus.address %></div>
            </div>

            <div>
              <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted);">ADMISSIONS DESK</div>
              <div style="color: var(--text-primary); margin-top: 0.25rem;">
                <a href="mailto:<%= campus.contactEmail %>" style="color: var(--accent-blue);"><%= campus.contactEmail %></a><br>
                <span><%= campus.contactPhone %></span>
              </div>
            </div>

            <div>
              <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted);">ANNUAL HOSTEL BASE</div>
              <div style="font-family: var(--font-mono); font-size: 1.1rem; font-weight: 700; color: var(--text-primary);">
                <%= formatCurrency(campus.annualHostelFeeDefault) %>/year
              </div>
            </div>
          </div>

          <div style="display: flex; flex-direction: column; gap: 0.75rem;">
            <a href="/student/application" class="btn btn-primary btn-full">Apply For <%= campus.city %> &rarr;</a>
            <a href="/fees?campusId=<%= campus._id %>" class="btn btn-secondary btn-full">Calculate Fee Plan</a>
            <a href="/contact" class="btn btn-secondary btn-full">Contact Campus Office</a>
          </div>
        </div>
      </aside>
    </div>
  </div>
</div>
