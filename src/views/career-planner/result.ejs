<div class="section-sm" style="background-color: var(--bg-surface); border-bottom: 1px solid var(--border-light);">
  <div class="container">
    <div style="font-family: var(--font-mono); font-size: 0.8125rem; color: var(--text-muted); margin-bottom: 0.5rem;">
      <a href="/">Home</a> / <a href="/career-planner">Career Match</a> / <span style="color: var(--text-primary);">Personalized Blueprint</span>
    </div>
    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">
      <span class="badge badge-success">Match Confidence: <%= plan.confidenceScore %></span>
      <span class="pill-tag"><%= plan.campus ? plan.campus.name : 'Bengaluru Campus' %></span>
    </div>
    <h1 style="font-size: 2.75rem; margin-bottom: 0.75rem;">Your Tailored 4-Year Career Blueprint</h1>
    <p class="lead" style="max-width: 820px;">
      Synthesized specifically for your background and aspiration to become a <strong><%= plan.careerOutcome.role %></strong>.
    </p>
  </div>
</div>

<div class="section">
  <div class="container">
    <div class="grid grid-2-1" style="gap: 3.5rem; align-items: start;">
      <div>
        <!-- 1. Recommended Degree & Specialization Track -->
        <div class="card" style="padding: 2.5rem; border: 2px solid #000000; margin-bottom: 3rem;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
            <span class="badge badge-accent">PRIMARY RECOMMENDATION</span>
            <span style="font-family: var(--font-mono); font-size: 0.8125rem; color: var(--text-muted);">B.Tech Degree</span>
          </div>

          <h2 style="font-size: 1.85rem; margin-bottom: 0.5rem;">
            <a href="/programs/<%= plan.recommendedProgram.slug %>" style="color: var(--text-primary);"><%= plan.recommendedProgram.name %></a>
          </h2>
          <div style="font-family: var(--font-mono); font-size: 0.9375rem; font-weight: 700; color: var(--accent-blue); margin-bottom: 1rem;">
            Specialization Track: <%= plan.recommendedTrack %>
          </div>

          <p style="color: var(--text-secondary); font-size: 0.9375rem; line-height: 1.6; margin-bottom: 1.5rem;">
            <%= plan.recommendedProgram.shortDescription %>
          </p>

          <div style="background-color: var(--bg-subtle); padding: 1.25rem; border-radius: var(--radius-sm); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
            <div>
              <div style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-muted);">EXPECTED STARTING COMPENSATION</div>
              <div style="font-family: var(--font-mono); font-size: 1.15rem; font-weight: 800; color: var(--brand-emerald);">
                <%= plan.careerOutcome.expectedStartingRange %>
              </div>
            </div>
            <div>
              <div style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-muted);">TOP HIRING ECOSYSTEM</div>
              <div style="font-size: 0.8125rem; font-weight: 600;">Google, OpenAI, Stripe, Anthropic</div>
            </div>
          </div>
        </div>

        <!-- 2. Customized 4-Year Milestone Progression Blueprint -->
        <div style="margin-bottom: 3.5rem;">
          <h2 style="font-size: 1.75rem; margin-bottom: 1.25rem;">Your Tailored 4-Year Journey</h2>
          
          <div style="display: flex; flex-direction: column; gap: 1.5rem;">
            <% plan.journeyMilestones.forEach(m => { %>
              <div class="card" style="padding: 2rem;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                  <span class="badge badge-dark"><%= m.year %></span>
                  <span style="font-family: var(--font-mono); font-size: 0.8125rem; color: var(--accent-blue); font-weight: 600;"><%= m.theme %></span>
                </div>

                <p style="font-size: 0.9375rem; color: var(--text-secondary); line-height: 1.6; margin-bottom: 1rem;">
                  <%= m.focus %>
                </p>

                <div style="display: flex; flex-wrap: wrap; gap: 0.35rem; margin-bottom: 1rem;">
                  <% m.coreStack.forEach(st => { %>
                    <span class="pill-tag" style="font-size: 0.75rem;"><%= st %></span>
                  <% }) %>
                </div>

                <div style="background-color: var(--bg-subtle); padding: 0.875rem 1rem; border-radius: var(--radius-sm); font-size: 0.8125rem;">
                  <strong style="color: var(--text-primary);">Capstone Deliverable:</strong>
                  <span style="color: var(--text-secondary);"><%= m.capstoneProject %></span>
                </div>
              </div>
            <% }) %>
          </div>
        </div>

        <!-- 3. Actionable Next Steps -->
        <div>
          <h2 style="font-size: 1.75rem; margin-bottom: 1.25rem;">Recommended Admissions Steps</h2>
          <div style="display: flex; flex-direction: column; gap: 1rem;">
            <% plan.nextSteps.forEach(step => { %>
              <div class="card" style="padding: 1.5rem; display: flex; flex-direction: row; gap: 1.25rem; align-items: center;">
                <div style="width: 40px; height: 40px; border-radius: 50%; background-color: #000000; color: #ffffff; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 1.1rem; flex-shrink: 0;">
                  <%= step.step %>
                </div>
                <div style="flex: 1;">
                  <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.25rem;">
                    <h4 style="margin-bottom: 0;"><%= step.title %></h4>
                    <span class="badge badge-accent" style="font-size: 0.65rem;"><%= step.badge %></span>
                  </div>
                  <p style="font-size: 0.8125rem; color: var(--text-secondary);"><%= step.description %></p>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      </div>

      <!-- Right Summary Blueprint Sidebar -->
      <aside>
        <div class="card" style="position: sticky; top: 6rem; padding: 2rem;">
          <h3 style="font-size: 1.35rem; margin-bottom: 1.25rem;">Investment & Aid Blueprint</h3>

          <% if (plan.estimatedCost) { %>
            <div style="display: flex; flex-direction: column; gap: 1rem; margin-bottom: 1.5rem;">
              <div>
                <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted);">ESTIMATED 4-YEAR NET COST</div>
                <div style="font-family: var(--font-mono); font-size: 1.75rem; font-weight: 800; color: var(--text-primary);">
                  <%= formatCurrency(plan.estimatedCost.breakdown.netTotalEstimated) %>
                </div>
              </div>

              <% if (plan.scholarship) { %>
                <div style="background-color: #ecfdf5; border: 1px solid #a7f3d0; padding: 0.75rem; border-radius: var(--radius-sm);">
                  <div style="font-size: 0.75rem; font-weight: 700; color: #065f46;">POTENTIAL SCHOLARSHIP APPLIED</div>
                  <div style="font-size: 0.8125rem; color: #065f46;"><%= plan.scholarship.name %> (<%= plan.scholarship.percentage %>%)</div>
                </div>
              <% } %>

              <div style="background-color: var(--bg-dark); color: #ffffff; padding: 1.25rem; border-radius: var(--radius-sm);">
                <div style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-inverse-muted);">ESTIMATED MONTHLY FINANCING (EMI)</div>
                <div style="font-family: var(--font-mono); font-size: 1.5rem; font-weight: 800; color: #ffffff;">
                  <%= formatCurrency(plan.estimatedCost.financing.monthlyEstimate) %><span style="font-size: 0.75rem; font-weight: 400; color: var(--text-inverse-muted);">/mo</span>
                </div>
                <div style="font-size: 0.7rem; color: var(--text-inverse-muted); margin-top: 0.25rem;">Over 48 months</div>
              </div>
            </div>
          <% } %>

          <div style="display: flex; flex-direction: column; gap: 0.75rem;">
            <a href="/student/application" class="btn btn-primary btn-full">Lock In Seat & Apply &rarr;</a>
            <a href="/fees" class="btn btn-secondary btn-full">Fine-tune in Fee Calculator</a>
            <a href="/career-planner" class="btn btn-outline-white" style="color: var(--text-secondary); border-color: var(--border-medium);">Recalculate Roadmap</a>
          </div>
        </div>
      </aside>
    </div>
  </div>
</div>
