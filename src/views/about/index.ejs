<div class="section-sm" style="background-color: var(--bg-surface); border-bottom: 1px solid var(--border-light);">
  <div class="container">
    <div style="font-family: var(--font-mono); font-size: 0.8125rem; color: var(--text-muted); margin-bottom: 0.5rem;">
      <a href="/">Home</a> / <span style="color: var(--text-primary);">About NOVA</span>
    </div>
    <h1 style="font-size: 2.75rem; margin-bottom: 0.75rem;">Re-Engineering Technical Education</h1>
    <p class="lead" style="max-width: 820px;">
      Why NOVA Institute of Technology was founded: To replace 20-year-old textbook theory with intense product shipping, AI fundamentals, and Silicon Valley mentorship.
    </p>
    <div class="alert alert-info" style="margin-top: 1.5rem; font-size: 0.8125rem;">
      <strong>Institutional Notice:</strong> Demo institution: all institutional statistics, programs, outcomes, mentors and financial figures shown on this website are fictional sample data created for demonstration purposes.
    </div>
  </div>
</div>

<div class="section">
  <div class="container">
    <!-- Founding Manifesto -->
    <div class="grid grid-2" style="gap: 4rem; align-items: center; margin-bottom: 5rem;">
      <div>
        <div class="eyebrow">Our Core Thesis</div>
        <h2 style="font-size: 2.25rem; margin-bottom: 1.25rem;">"Students should graduate with a degree AND a portfolio of things they actually built."</h2>
        <p style="color: var(--text-secondary); font-size: 1.0625rem; line-height: 1.7; margin-bottom: 1.5rem;">
          In 2026, artificial intelligence writes boilerplate code in milliseconds. Memorizing algorithms for a handwritten exam is obsolete. What the global technology industry demands are engineers who can architect distributed systems, fine-tune foundation models, reason about GPU memory kernels, and ship resilient products to real users.
        </p>
        <p style="color: var(--text-secondary); font-size: 1.0625rem; line-height: 1.7;">
          At NOVA, our students spend 70% of their academic time inside labs, IDEs, and venture studios rather than lecture halls.
        </p>
      </div>

      <div class="card" style="background-color: var(--bg-dark); color: #ffffff; padding: 3rem; border-color: var(--border-dark);">
        <h3 style="color: #ffffff; margin-bottom: 1.5rem; font-size: 1.5rem;">The NOVA Code</h3>
        <div style="display: flex; flex-direction: column; gap: 1.25rem; font-size: 0.9375rem;">
          <div>
            <strong style="color: #60a5fa; display: block; margin-bottom: 0.2rem;">01. BUILD FIRST</strong>
            <span style="color: var(--text-inverse-muted);">Never teach a theory without having the student implement its working software model immediately.</span>
          </div>
          <div>
            <strong style="color: #60a5fa; display: block; margin-bottom: 0.2rem;">02. LEARN DEEPLY</strong>
            <span style="color: var(--text-inverse-muted);">Understand the entire stack: from silicon logic gates and C/Rust memory to high-level multi-agent LLMs.</span>
          </div>
          <div>
            <strong style="color: #60a5fa; display: block; margin-bottom: 0.2rem;">03. SHIP RELENTLESSLY</strong>
            <span style="color: var(--text-inverse-muted);">A project only exists once it has a public GitHub repository, containerized build, and live URL.</span>
          </div>
        </div>
      </div>
    </div>

    <!-- NOVA Venture Labs Section -->
    <div class="card" style="padding: 3.5rem; background-color: var(--bg-surface); border: 2px solid #000000; margin-bottom: 5rem;">
      <div class="grid grid-2" style="gap: 3rem; align-items: center;">
        <div>
          <div class="eyebrow">Student Startup Incubation</div>
          <h2 style="margin-bottom: 1rem;">NOVA Venture Labs</h2>
          <p style="color: var(--text-secondary); line-height: 1.6; margin-bottom: 1.5rem;">
            We don't just prepare students for jobs; we fund their companies. NOVA Venture Lab provides ₹10 Lakhs in non-dilutive pre-seed grants, dedicated incubator space, cloud credits ($100k AWS/GCP), and investor demo days with top venture capital funds.
          </p>
          <div style="display: flex; gap: 1rem;">
            <a href="/projects?category=startup" class="btn btn-primary">Explore Student Startups &rarr;</a>
          </div>
        </div>
        <div>
          <div style="background-color: var(--bg-subtle); padding: 2rem; border-radius: var(--radius-sm); display: flex; flex-direction: column; gap: 1rem;">
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <span style="font-family: var(--font-mono); font-size: 0.8125rem;">SEED POOL ALLOCATED</span>
              <strong style="font-family: var(--font-mono); font-size: 1.25rem;">₹50,00,000+</strong>
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <span style="font-family: var(--font-mono); font-size: 0.8125rem;">STARTUPS INCUBATED</span>
              <strong style="font-family: var(--font-mono); font-size: 1.25rem;"><%= stats.startups.number %></strong>
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <span style="font-family: var(--font-mono); font-size: 0.8125rem;">EXTERNAL CAPITAL RAISED</span>
              <strong style="font-family: var(--font-mono); font-size: 1.25rem; color: var(--brand-emerald);">₹12.4 Cr+</strong>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Leadership Mentors Highlight -->
    <% if (mentors && mentors.length > 0) { %>
      <div>
        <div class="section-header text-center">
          <div class="eyebrow">Governance & Academic Fellows</div>
          <h2>Advisory Council & Key Fellows</h2>
        </div>

        <div class="grid grid-3">
          <% mentors.forEach(mentor => { %>
            <%- include('../partials/mentorCard', { mentor }) %>
          <% }) %>
        </div>
      </div>
    <% } %>
  </div>
</div>
