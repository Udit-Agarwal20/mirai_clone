<div class="section-sm" style="background-color: var(--bg-surface); border-bottom: 1px solid var(--border-light);">
  <div class="container">
    <div style="font-family: var(--font-mono); font-size: 0.8125rem; color: var(--text-muted); margin-bottom: 0.5rem;">
      <a href="/student/dashboard">Dashboard</a> / <span style="color: var(--text-primary);">Saved Bookmarks</span>
    </div>
    <h1 style="font-size: 2.25rem; margin-bottom: 0.25rem;">Saved Programs, Projects & Plans</h1>
    <p style="font-size: 0.9375rem; color: var(--text-secondary);">Your personal collection of saved degree tracks, student case studies, and fee calculations.</p>
  </div>
</div>

<div class="section">
  <div class="container">
    <!-- Saved Programs -->
    <div style="margin-bottom: 3.5rem;">
      <h2 style="font-size: 1.5rem; margin-bottom: 1.25rem;">Saved Academic Programs (<%= savedPrograms.length %>)</h2>
      <% if (savedPrograms.length > 0) { %>
        <div class="grid grid-2">
          <% savedPrograms.forEach(program => { %>
            <%- include('../partials/programCard', { program }) %>
          <% }) %>
        </div>
      <% } else { %>
        <div class="card text-center" style="padding: 2.5rem;">
          <p style="color: var(--text-secondary); margin-bottom: 1rem;">You haven't bookmarked any programs yet.</p>
          <a href="/programs" class="btn btn-secondary btn-sm">Browse Programs</a>
        </div>
      <% } %>
    </div>

    <!-- Saved Projects -->
    <div style="margin-bottom: 3.5rem;">
      <h2 style="font-size: 1.5rem; margin-bottom: 1.25rem;">Saved Student Projects (<%= savedProjects.length %>)</h2>
      <% if (savedProjects.length > 0) { %>
        <div class="grid grid-3">
          <% savedProjects.forEach(project => { %>
            <%- include('../partials/projectCard', { project }) %>
          <% }) %>
        </div>
      <% } else { %>
        <div class="card text-center" style="padding: 2.5rem;">
          <p style="color: var(--text-secondary); margin-bottom: 1rem;">No projects saved yet.</p>
          <a href="/projects" class="btn btn-secondary btn-sm">Explore Student Projects</a>
        </div>
      <% } %>
    </div>

    <!-- Saved Fee Estimates -->
    <div>
      <h2 style="font-size: 1.5rem; margin-bottom: 1.25rem;">Saved Cost & Financing Projections (<%= savedCalculations.length %>)</h2>
      <% if (savedCalculations.length > 0) { %>
        <div class="grid grid-3">
          <% savedCalculations.forEach(calc => { %>
            <div class="card" style="padding: 1.75rem;">
              <h4 style="font-size: 1.15rem; margin-bottom: 0.25rem;"><%= calc.program ? calc.program.name : 'B.Tech Degree' %></h4>
              <div style="font-size: 0.8125rem; color: var(--text-secondary); margin-bottom: 1rem;">
                <%= calc.campus ? calc.campus.name : 'Campus' %>
              </div>

              <div class="calc-summary-box">
                <div class="calc-row">
                  <span style="color: var(--text-secondary);">4-Year Net:</span>
                  <strong><%= formatCurrency(calc.breakdown.netTotalEstimated) %></strong>
                </div>
                <div class="calc-row">
                  <span style="color: var(--text-secondary);">Monthly EMI:</span>
                  <strong style="color: var(--accent-blue);"><%= formatCurrency(calc.breakdown.monthlyFinancingEstimate) %>/mo</strong>
                </div>
              </div>

              <div style="font-size: 0.75rem; color: var(--text-muted);">
                <%= formatDate(calc.createdAt) %>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="card text-center" style="padding: 2.5rem;">
          <p style="color: var(--text-secondary); margin-bottom: 1rem;">No fee calculations saved.</p>
          <a href="/fees" class="btn btn-secondary btn-sm">Open Fee Planner</a>
        </div>
      <% } %>
    </div>
  </div>
</div>
