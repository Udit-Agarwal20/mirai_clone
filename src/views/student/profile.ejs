<div class="section-sm" style="background-color: var(--bg-surface); border-bottom: 1px solid var(--border-light);">
  <div class="container">
    <div style="font-family: var(--font-mono); font-size: 0.8125rem; color: var(--text-muted); margin-bottom: 0.5rem;">
      <a href="/student/dashboard">Dashboard</a> / <span style="color: var(--text-primary);">Student Profile</span>
    </div>
    <h1 style="font-size: 2.25rem; margin-bottom: 0.25rem;">Personal Profile</h1>
    <p style="font-size: 0.9375rem; color: var(--text-secondary);">Manage your contact details and academic background.</p>
  </div>
</div>

<div class="section">
  <div class="container" style="max-width: 760px;">
    <div class="card" style="padding: 2.5rem;">
      <form action="/student/profile" method="POST">
        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="profName">Full Name <span class="required">*</span></label>
            <input type="text" id="profName" name="name" class="form-control" required value="<%= student.name %>">
          </div>

          <div class="form-group">
            <label class="form-label">Email Address</label>
            <input type="email" class="form-control" value="<%= student.email %>" disabled style="background-color: var(--bg-subtle);">
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="profPhone">Phone Number</label>
            <input type="tel" id="profPhone" name="phone" class="form-control" value="<%= student.phone || '' %>">
          </div>

          <div class="form-group">
            <label class="form-label" for="profDob">Date of Birth</label>
            <input type="date" id="profDob" name="dob" class="form-control" value="<%= student.profile?.dob ? new Date(student.profile.dob).toISOString().split('T')[0] : '' %>">
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="profAddress">Address</label>
          <input type="text" id="profAddress" name="address" class="form-control" value="<%= student.profile?.address || '' %>">
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="profCity">City</label>
            <input type="text" id="profCity" name="city" class="form-control" value="<%= student.profile?.city || '' %>">
          </div>

          <div class="form-group">
            <label class="form-label" for="profState">State</label>
            <input type="text" id="profState" name="state" class="form-control" value="<%= student.profile?.state || '' %>">
          </div>

          <div class="form-group">
            <label class="form-label" for="profPincode">Pincode</label>
            <input type="text" id="profPincode" name="pincode" class="form-control" value="<%= student.profile?.pincode || '' %>">
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="profHighSchool">High School Name</label>
            <input type="text" id="profHighSchool" name="highSchool" class="form-control" value="<%= student.profile?.highSchool || '' %>">
          </div>

          <div class="form-group">
            <label class="form-label" for="profPcm">12th PCM (%)</label>
            <input type="number" id="profPcm" name="pcmPercentage" class="form-control" step="0.1" value="<%= student.profile?.pcmPercentage || '' %>">
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="profGithub">GitHub Username / URL</label>
          <input type="text" id="profGithub" name="githubUsername" class="form-control" value="<%= student.profile?.githubUsername || '' %>">
        </div>

        <button type="submit" class="btn btn-primary btn-lg" style="margin-top: 1rem;">Save Changes &rarr;</button>
      </form>
    </div>
  </div>
</div>
