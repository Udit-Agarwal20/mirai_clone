<div style="margin-bottom: 2rem;">
  <div style="font-family: var(--font-mono); font-size: 0.8125rem; color: var(--text-muted); margin-bottom: 0.5rem;">
    <a href="/admin/campuses">Campuses</a> / <span style="color: var(--text-primary);"><%= isEdit ? `Edit: ${campus.name}` : 'New Campus' %></span>
  </div>
  <h2 style="font-size: 1.75rem;"><%= isEdit ? `Edit Campus: ${campus.name}` : 'Create Innovation Campus' %></h2>
</div>

<div class="card" style="padding: 2.5rem; max-width: 860px;">
  <form action="<%= isEdit ? `/admin/campuses/${campus._id}` : '/admin/campuses' %>" method="POST">
    <div class="form-row">
      <div class="form-group">
        <label class="form-label" for="campName">Campus Name <span class="required">*</span></label>
        <input type="text" id="campName" name="name" class="form-control" placeholder="e.g. Bengaluru Innovation Campus" required value="<%= campus.name || '' %>">
      </div>

      <div class="form-group">
        <label class="form-label" for="campSlug">URL Slug</label>
        <input type="text" id="campSlug" name="slug" class="form-control" placeholder="bengaluru-innovation-campus" value="<%= campus.slug || '' %>">
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label class="form-label" for="campCity">City <span class="required">*</span></label>
        <input type="text" id="campCity" name="city" class="form-control" required value="<%= campus.city || '' %>">
      </div>

      <div class="form-group">
        <label class="form-label" for="campState">State <span class="required">*</span></label>
        <input type="text" id="campState" name="state" class="form-control" required value="<%= campus.state || '' %>">
      </div>
    </div>

    <div class="form-group">
      <label class="form-label" for="campTag">Tagline</label>
      <input type="text" id="campTag" name="tagline" class="form-control" placeholder="Silicon Valley of the East" value="<%= campus.tagline || '' %>">
    </div>

    <div class="form-group">
      <label class="form-label" for="campDesc">Description <span class="required">*</span></label>
      <textarea id="campDesc" name="description" class="form-textarea" rows="4" required><%= campus.description || '' %></textarea>
    </div>

    <div class="form-group">
      <label class="form-label" for="campAddress">Physical Address <span class="required">*</span></label>
      <input type="text" id="campAddress" name="address" class="form-control" required value="<%= campus.address || '' %>">
    </div>

    <div class="form-row">
      <div class="form-group">
        <label class="form-label" for="campSeats">Available Seats</label>
        <input type="number" id="campSeats" name="availableSeats" class="form-control" value="<%= campus.availableSeats || 240 %>">
      </div>

      <div class="form-group">
        <label class="form-label" for="campHostel">Default Annual Hostel Fee (INR ₹)</label>
        <input type="number" id="campHostel" name="annualHostelFeeDefault" class="form-control" value="<%= campus.annualHostelFeeDefault || 180000 %>">
      </div>

      <div class="form-group">
        <label class="form-label" for="campStatus">Admissions Status</label>
        <select name="status" id="campStatus" class="form-select">
          <option value="Admissions Open" <%= campus.status === 'Admissions Open' ? 'selected' : '' %>>Admissions Open</option>
          <option value="Limited Seats" <%= campus.status === 'Limited Seats' ? 'selected' : '' %>>Limited Seats</option>
          <option value="Waitlist Open" <%= campus.status === 'Waitlist Open' ? 'selected' : '' %>>Waitlist Open</option>
          <option value="Applications Closed" <%= campus.status === 'Applications Closed' ? 'selected' : '' %>>Applications Closed</option>
        </select>
      </div>
    </div>

    <div style="display: flex; gap: 1rem; margin-top: 1.5rem;">
      <button type="submit" class="btn btn-primary"><%= isEdit ? 'Update Campus' : 'Create Campus' %> &rarr;</button>
      <a href="/admin/campuses" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</div>
