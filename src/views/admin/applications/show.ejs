<div style="margin-bottom: 2rem;">
  <div style="font-family: var(--font-mono); font-size: 0.8125rem; color: var(--text-muted); margin-bottom: 0.5rem;">
    <a href="/admin/applications">Applications</a> / <span style="color: var(--text-primary);"><%= application.applicationId %></span>
  </div>
  <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
    <div>
      <h2 style="font-size: 1.75rem; margin-bottom: 0.25rem;">Candidate: <%= application.personalInfo?.fullName %></h2>
      <div style="font-size: 0.875rem; color: var(--text-secondary);">Application ID: <strong><%= application.applicationId %></strong> • Submitted on <%= formatDate(application.createdAt) %></div>
    </div>
    <span class="badge <%= application.status === 'OFFERED' || application.status === 'ENROLLED' ? 'badge-success' : 'badge-accent' %>" style="font-size: 0.875rem; padding: 0.5rem 1rem;">
      Status: <%= application.status %>
    </span>
  </div>
</div>

<div class="grid grid-2-1" style="gap: 2.5rem; align-items: start;">
  <div>
    <!-- Candidate Personal Info -->
    <div class="card" style="padding: 2rem; margin-bottom: 2rem;">
      <h3 style="font-size: 1.25rem; margin-bottom: 1.25rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border-light);">
        1. Personal & Contact Details
      </h3>
      <div class="grid grid-2" style="font-size: 0.875rem; gap: 1rem;">
        <div>
          <span style="color: var(--text-muted); font-size: 0.75rem; display: block;">EMAIL</span>
          <a href="mailto:<%= application.personalInfo?.email %>" style="color: var(--accent-blue); font-weight: 600;"><%= application.personalInfo?.email %></a>
        </div>
        <div>
          <span style="color: var(--text-muted); font-size: 0.75rem; display: block;">PHONE NUMBER</span>
          <strong><%= application.personalInfo?.phone %></strong>
        </div>
        <div>
          <span style="color: var(--text-muted); font-size: 0.75rem; display: block;">GENDER / DOB</span>
          <span><%= application.personalInfo?.gender || 'N/A' %> • <%= application.personalInfo?.dob ? formatDate(application.personalInfo.dob) : 'N/A' %></span>
        </div>
        <div>
          <span style="color: var(--text-muted); font-size: 0.75rem; display: block;">PARENT / GUARDIAN</span>
          <span><%= application.personalInfo?.guardianName || 'N/A' %> (<%= application.personalInfo?.guardianPhone || 'N/A' %>)</span>
        </div>
        <div style="grid-column: span 2;">
          <span style="color: var(--text-muted); font-size: 0.75rem; display: block;">ADDRESS</span>
          <span><%= application.personalInfo?.address %>, <%= application.personalInfo?.city %>, <%= application.personalInfo?.state %> - <%= application.personalInfo?.pincode %></span>
        </div>
      </div>
    </div>

    <!-- Candidate Academic Details -->
    <div class="card" style="padding: 2rem; margin-bottom: 2rem;">
      <h3 style="font-size: 1.25rem; margin-bottom: 1.25rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border-light);">
        2. Academic Background & Portfolio
      </h3>
      <div class="grid grid-2" style="font-size: 0.875rem; gap: 1rem;">
        <div>
          <span style="color: var(--text-muted); font-size: 0.75rem; display: block;">HIGH SCHOOL & BOARD</span>
          <strong><%= application.academicInfo?.highSchool || 'N/A' %> (<%= application.academicInfo?.board || 'N/A' %>)</strong>
        </div>
        <div>
          <span style="color: var(--text-muted); font-size: 0.75rem; display: block;">12TH PCM AGGREGATE</span>
          <strong style="font-family: var(--font-mono); font-size: 1.1rem; color: var(--brand-emerald);"><%= application.academicInfo?.pcmPercentage %>%</strong>
        </div>
        <div>
          <span style="color: var(--text-muted); font-size: 0.75rem; display: block;">ENTRANCE EXAM</span>
          <span><%= application.academicInfo?.entranceExam || 'JEE Main' %>: <%= application.academicInfo?.entranceScore || 'N/A' %></span>
        </div>
        <div>
          <span style="color: var(--text-muted); font-size: 0.75rem; display: block;">CODING LEVEL</span>
          <span><%= application.academicInfo?.codingExperience %></span>
        </div>
        <div style="grid-column: span 2;">
          <span style="color: var(--text-muted); font-size: 0.75rem; display: block;">PORTFOLIO / GITHUB</span>
          <% if (application.academicInfo?.githubUrl) { %>
            <a href="<%= application.academicInfo.githubUrl %>" target="_blank" style="color: var(--accent-blue); font-weight: 600; text-decoration: underline;"><%= application.academicInfo.githubUrl %> ↗</a>
          <% } else { %>
            <span>No link provided</span>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Program & SOP Details -->
    <div class="card" style="padding: 2rem; margin-bottom: 2rem;">
      <h3 style="font-size: 1.25rem; margin-bottom: 1.25rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border-light);">
        3. Preferences & Statement of Purpose
      </h3>
      <div style="display: flex; flex-direction: column; gap: 1rem; font-size: 0.875rem;">
        <div>
          <span style="color: var(--text-muted); font-size: 0.75rem; display: block;">CHOSEN PROGRAM & CAMPUS</span>
          <strong><%= application.preferences?.program?.name %></strong> at <strong><%= application.preferences?.campus?.name %></strong>
        </div>
        <% if (application.statementOfPurpose) { %>
          <div>
            <span style="color: var(--text-muted); font-size: 0.75rem; display: block; margin-bottom: 0.25rem;">STATEMENT OF PURPOSE</span>
            <div style="background-color: var(--bg-subtle); padding: 1rem; border-radius: var(--radius-sm); font-style: italic; line-height: 1.6;">
              "<%= application.statementOfPurpose %>"
            </div>
          </div>
        <% } %>
        <% if (application.careerGoal) { %>
          <div>
            <span style="color: var(--text-muted); font-size: 0.75rem; display: block;">4-YEAR CAREER GOAL</span>
            <strong><%= application.careerGoal %></strong>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Activity Log -->
    <div class="card" style="padding: 2rem;">
      <h3 style="font-size: 1.25rem; margin-bottom: 1.25rem;">Application Audit Log</h3>
      <div class="timeline-log">
        <% if (application.timeline && application.timeline.length > 0) { %>
          <% application.timeline.slice().reverse().forEach(log => { %>
            <div class="log-item">
              <div class="log-stage"><%= log.stage %></div>
              <div class="log-time"><%= formatDate(log.timestamp) %> • By <%= log.updatedBy %></div>
              <div class="log-note"><%= log.note %></div>
            </div>
          <% }) %>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Status Control Panel Sidebar -->
  <aside>
    <div class="card" style="position: sticky; top: 2rem; padding: 2rem; border: 2px solid #000000;">
      <h3 style="font-size: 1.25rem; margin-bottom: 1.25rem;">Update Application State</h3>

      <form action="/admin/applications/<%= application._id %>/status" method="POST">
        <div class="form-group">
          <label class="form-label" for="appStatus">Target Status <span class="required">*</span></label>
          <select name="status" id="appStatus" class="form-select" required>
            <option value="DRAFT" <%= application.status === 'DRAFT' ? 'selected' : '' %>>DRAFT</option>
            <option value="SUBMITTED" <%= application.status === 'SUBMITTED' ? 'selected' : '' %>>SUBMITTED</option>
            <option value="UNDER_REVIEW" <%= application.status === 'UNDER_REVIEW' ? 'selected' : '' %>>UNDER_REVIEW</option>
            <option value="ASSESSMENT" <%= application.status === 'ASSESSMENT' ? 'selected' : '' %>>ASSESSMENT</option>
            <option value="INTERVIEW" <%= application.status === 'INTERVIEW' ? 'selected' : '' %>>INTERVIEW</option>
            <option value="OFFERED" <%= application.status === 'OFFERED' ? 'selected' : '' %>>OFFERED</option>
            <option value="ENROLLED" <%= application.status === 'ENROLLED' ? 'selected' : '' %>>ENROLLED</option>
            <option value="REJECTED" <%= application.status === 'REJECTED' ? 'selected' : '' %>>REJECTED</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="scholarshipGranted">Scholarship Grant (% Waiver)</label>
          <input type="number" id="scholarshipGranted" name="scholarshipGrantedPercentage" class="form-control" placeholder="e.g. 50" min="0" max="100" value="<%= application.offerDetails?.scholarshipGrantedPercentage || '' %>">
        </div>

        <div class="form-group">
          <label class="form-label" for="assessmentScore">Assessment Score (0-100)</label>
          <input type="number" id="assessmentScore" name="assessmentScore" class="form-control" placeholder="e.g. 94" min="0" max="100" value="<%= application.assessmentDetails?.score || '' %>">
        </div>

        <div class="form-group">
          <label class="form-label" for="interviewLink">Interview Video Link</label>
          <input type="url" id="interviewLink" name="interviewMeetingLink" class="form-control" placeholder="https://meet.google.com/..." value="<%= application.interviewDetails?.meetingLink || '' %>">
        </div>

        <div class="form-group">
          <label class="form-label" for="adminNotes">Internal Reviewer Notes</label>
          <textarea id="adminNotes" name="adminNotes" class="form-textarea" rows="3" placeholder="Notes on portfolio review, interview feedback, or rationale..."><%= application.adminNotes || '' %></textarea>
        </div>

        <button type="submit" class="btn btn-primary btn-full">Save Status Changes &rarr;</button>
      </form>
    </div>
  </aside>
</div>
