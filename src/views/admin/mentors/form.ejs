<div style="margin-bottom: 2rem;">
  <div style="font-family: var(--font-mono); font-size: 0.8125rem; color: var(--text-muted); margin-bottom: 0.5rem;">
    <a href="/admin/mentors">Mentors</a> / <span style="color: var(--text-primary);"><%= isEdit ? `Edit: ${mentor.name}` : 'New Mentor' %></span>
  </div>
  <h2 style="font-size: 1.75rem;"><%= isEdit ? `Edit Mentor: ${mentor.name}` : 'Add Faculty / Mentor' %></h2>
</div>

<div class="card" style="padding: 2.5rem; max-width: 860px;">
  <form action="<%= isEdit ? `/admin/mentors/${mentor._id}` : '/admin/mentors' %>" method="POST">
    <div class="form-row">
      <div class="form-group">
        <label class="form-label" for="mentorName">Full Name <span class="required">*</span></label>
        <input type="text" id="mentorName" name="name" class="form-control" placeholder="e.g. Dr. Evelyn Vance" required value="<%= mentor.name || '' %>">
      </div>

      <div class="form-group">
        <label class="form-label" for="mentorRole">Role / Title <span class="required">*</span></label>
        <input type="text" id="mentorRole" name="role" class="form-control" placeholder="e.g. Research Scientist" required value="<%= mentor.role || '' %>">
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label class="form-label" for="company">Company / Institution <span class="required">*</span></label>
        <input type="text" id="company" name="company" class="form-control" placeholder="e.g. Google DeepMind" required value="<%= mentor.company || '' %>">
      </div>

      <div class="form-group">
        <label class="form-label" for="image">Avatar Image URL</label>
        <input type="url" id="image" name="image" class="form-control" placeholder="https://images.unsplash.com/..." value="<%= mentor.image || '' %>">
      </div>
    </div>

    <div class="form-group">
      <label class="form-label" for="mentorBio">Bio & Experience <span class="required">*</span></label>
      <textarea id="mentorBio" name="bio" class="form-textarea" rows="4" required><%= mentor.bio || '' %></textarea>
    </div>

    <div class="form-group">
      <label class="form-label" for="expertise">Expertise Areas (Comma-separated)</label>
      <input type="text" id="expertise" name="expertise" class="form-control" placeholder="Large Language Models, CUDA, Robotics" value="<%= mentor.expertise ? mentor.expertise.join(', ') : '' %>">
    </div>

    <div class="form-row">
      <div class="form-group">
        <label class="form-label" for="linkedin">LinkedIn URL</label>
        <input type="url" id="linkedin" name="linkedin" class="form-control" placeholder="https://linkedin.com/in/..." value="<%= mentor.linkedin || '' %>">
      </div>

      <div class="form-group">
        <label class="form-label" for="order">Display Order</label>
        <input type="number" id="order" name="order" class="form-control" value="<%= mentor.order || 0 %>">
      </div>
    </div>

    <div class="form-check" style="margin-top: 1rem;">
      <input type="checkbox" name="featured" id="featured" class="form-check-input" <%= mentor.featured ? 'checked' : '' %>>
      <label for="featured" class="form-check-label">Featured on Homepage</label>
    </div>

    <div style="display: flex; gap: 1rem; margin-top: 1.5rem;">
      <button type="submit" class="btn btn-primary"><%= isEdit ? 'Update Mentor' : 'Add Mentor' %> &rarr;</button>
      <a href="/admin/mentors" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</div>
