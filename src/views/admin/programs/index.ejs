<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
  <div>
    <h2 style="font-size: 1.5rem; margin-bottom: 0.25rem;">Academic Programs Management</h2>
    <p style="font-size: 0.875rem; color: var(--text-secondary);">Manage degrees, curriculums, and tuition fees.</p>
  </div>
  <a href="/admin/programs/new" class="btn btn-primary">+ Create New Program</a>
</div>

<div class="table-container">
  <table class="data-table">
    <thead>
      <tr>
        <th>Program Name</th>
        <th>Degree & Duration</th>
        <th>Annual Tuition</th>
        <th>Campuses</th>
        <th>Status</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if (programs && programs.length > 0) { %>
        <% programs.forEach(program => { %>
          <tr>
            <td>
              <strong><%= program.name %></strong>
              <div style="font-size: 0.75rem; color: var(--text-muted);"><%= program.slug %></div>
            </td>
            <td><%= program.degree %> • <%= program.duration %></td>
            <td style="font-family: var(--font-mono);"><%= formatCurrency(program.fees.tuitionPerYear) %>/yr</td>
            <td>
              <div style="display: flex; gap: 0.25rem; flex-wrap: wrap;">
                <% if (program.campuses && program.campuses.length > 0) { %>
                  <% program.campuses.forEach(c => { %>
                    <span class="pill-tag" style="font-size: 0.65rem;"><%= c.city %></span>
                  <% }) %>
                <% } %>
              </div>
            </td>
            <td>
              <span class="badge <%= program.isActive ? 'badge-success' : 'badge-subtle' %>">
                <%= program.isActive ? 'Active' : 'Inactive' %>
              </span>
            </td>
            <td>
              <div style="display: flex; gap: 0.5rem;">
                <a href="/admin/programs/<%= program._id %>/edit" class="btn btn-sm btn-secondary">Edit</a>
                <form action="/admin/programs/<%= program._id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this program?');" style="display: inline;">
                  <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      <% } else { %>
        <tr>
          <td colspan="6" style="text-align: center; color: var(--text-muted); padding: 3rem;">No programs found.</td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>
