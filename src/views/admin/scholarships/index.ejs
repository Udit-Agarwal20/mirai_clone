<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
  <div>
    <h2 style="font-size: 1.5rem; margin-bottom: 0.25rem;">Scholarship Programs Management</h2>
    <p style="font-size: 0.875rem; color: var(--text-secondary);">Configure merit waivers, category grants, and eligibility thresholds.</p>
  </div>
  <a href="/admin/scholarships/new" class="btn btn-primary">+ Create Scholarship</a>
</div>

<div class="table-container">
  <table class="data-table">
    <thead>
      <tr>
        <th>Scholarship Name</th>
        <th>Category</th>
        <th>Tuition Waiver</th>
        <th>Eligibility Criteria</th>
        <th>Status</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if (scholarships && scholarships.length > 0) { %>
        <% scholarships.forEach(sch => { %>
          <tr>
            <td>
              <strong><%= sch.name %></strong>
              <div style="font-size: 0.75rem; color: var(--text-muted);"><%= sch.slug %></div>
            </td>
            <td><%= sch.category %></td>
            <td>
              <span class="badge badge-accent"><%= sch.percentage %>% Waiver</span>
            </td>
            <td style="font-size: 0.8125rem;">
              <% if (sch.eligibilityRules?.minPcm) { %>
                <span>Min PCM: <%= sch.eligibilityRules.minPcm %>%</span>
              <% } else { %>
                <span>General Criteria</span>
              <% } %>
            </td>
            <td>
              <span class="badge <%= sch.isActive ? 'badge-success' : 'badge-subtle' %>">
                <%= sch.isActive ? 'Active' : 'Inactive' %>
              </span>
            </td>
            <td>
              <div style="display: flex; gap: 0.5rem;">
                <a href="/admin/scholarships/<%= sch._id %>/edit" class="btn btn-sm btn-secondary">Edit</a>
                <form action="/admin/scholarships/<%= sch._id %>/delete" method="POST" onsubmit="return confirm('Delete this scholarship?');" style="display: inline;">
                  <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      <% } else { %>
        <tr>
          <td colspan="6" style="text-align: center; color: var(--text-muted); padding: 3rem;">No scholarships found.</td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>
