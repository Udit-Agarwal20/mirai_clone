<div style="margin-bottom: 2rem;">
  <div style="font-family: var(--font-mono); font-size: 0.8125rem; color: var(--text-muted); margin-bottom: 0.5rem;">
    <a href="/admin/events">Events</a> / <span style="color: var(--text-primary);"><%= isEdit ? `Edit: ${event.title}` : 'New Event' %></span>
  </div>
  <h2 style="font-size: 1.75rem;"><%= isEdit ? `Edit Event: ${event.title}` : 'Create Admission Event' %></h2>
</div>

<div class="card" style="padding: 2.5rem; max-width: 860px;">
  <form action="<%= isEdit ? `/admin/events/${event._id}` : '/admin/events' %>" method="POST">
    <div class="form-row">
      <div class="form-group">
        <label class="form-label" for="eventTitle">Event / Deadline Title <span class="required">*</span></label>
        <input type="text" id="eventTitle" name="title" class="form-control" placeholder="e.g. Priority Admissions Round (2026 Intake)" required value="<%= event.title || '' %>">
      </div>

      <div class="form-group">
        <label class="form-label" for="eventType">Event Type <span class="required">*</span></label>
        <select name="type" id="eventType" class="form-select">
          <option value="APPLICATION_DEADLINE" <%= event.type === 'APPLICATION_DEADLINE' ? 'selected' : '' %>>APPLICATION_DEADLINE</option>
          <option value="APPLICATION_OPENS" <%= event.type === 'APPLICATION_OPENS' ? 'selected' : '' %>>APPLICATION_OPENS</option>
          <option value="ASSESSMENT" <%= event.type === 'ASSESSMENT' ? 'selected' : '' %>>ASSESSMENT</option>
          <option value="INTERVIEW" <%= event.type === 'INTERVIEW' ? 'selected' : '' %>>INTERVIEW</option>
          <option value="ENROLLMENT" <%= event.type === 'ENROLLMENT' ? 'selected' : '' %>>ENROLLMENT</option>
          <option value="CAMPUS_OPEN_HOUSE" <%= event.type === 'CAMPUS_OPEN_HOUSE' ? 'selected' : '' %>>CAMPUS_OPEN_HOUSE</option>
          <option value="WEBINAR" <%= event.type === 'WEBINAR' ? 'selected' : '' %>>WEBINAR</option>
        </select>
      </div>
    </div>

    <div class="form-group">
      <label class="form-label" for="campusName">Location / Campus Scope</label>
      <input type="text" id="campusName" name="campusName" class="form-control" placeholder="All Campuses (Online) or Bengaluru Innovation Campus" value="<%= event.campusName || 'All Campuses (Online)' %>">
    </div>

    <div class="form-row">
      <div class="form-group">
        <label class="form-label" for="startDate">Start Date <span class="required">*</span></label>
        <input type="datetime-local" id="startDate" name="startDate" class="form-control" required value="<%= event.startDate ? new Date(event.startDate).toISOString().slice(0, 16) : '' %>">
      </div>

      <div class="form-group">
        <label class="form-label" for="endDate">End Date / Deadline <span class="required">*</span></label>
        <input type="datetime-local" id="endDate" name="endDate" class="form-control" required value="<%= event.endDate ? new Date(event.endDate).toISOString().slice(0, 16) : '' %>">
      </div>
    </div>

    <div class="form-group">
      <label class="form-label" for="eventDesc">Description</label>
      <textarea id="eventDesc" name="description" class="form-textarea" rows="3"><%= event.description || '' %></textarea>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label class="form-label" for="actionUrl">Action Button URL</label>
        <input type="text" id="actionUrl" name="actionUrl" class="form-control" placeholder="/student/application" value="<%= event.actionUrl || '/student/application' %>">
      </div>

      <div class="form-group">
        <label class="form-label" for="actionText">Action Button Text</label>
        <input type="text" id="actionText" name="actionText" class="form-control" placeholder="Apply Now" value="<%= event.actionText || 'Apply Now' %>">
      </div>
    </div>

    <div class="form-check" style="margin-top: 1rem;">
      <input type="checkbox" name="isActive" id="isActive" class="form-check-input" <%= event.isActive !== false ? 'checked' : '' %>>
      <label for="isActive" class="form-check-label">Active (Used in Dynamic Countdown Calculation)</label>
    </div>

    <div style="display: flex; gap: 1rem; margin-top: 1.5rem;">
      <button type="submit" class="btn btn-primary"><%= isEdit ? 'Update Event' : 'Create Event' %> &rarr;</button>
      <a href="/admin/events" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</div>
