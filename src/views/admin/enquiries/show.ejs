<div style="margin-bottom: 2rem;">
  <div style="font-family: var(--font-mono); font-size: 0.8125rem; color: var(--text-muted); margin-bottom: 0.5rem;">
    <a href="/admin/enquiries">Inquiries</a> / <span style="color: var(--text-primary);"><%= enquiry.subject %></span>
  </div>
  <h2 style="font-size: 1.75rem;"><%= enquiry.subject %></h2>
</div>

<div class="grid grid-2-1" style="gap: 2.5rem; align-items: start;">
  <div>
    <div class="card" style="padding: 2rem; margin-bottom: 2rem;">
      <h3 style="font-size: 1.25rem; margin-bottom: 1rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border-light);">
        Sender Details
      </h3>
      <div class="grid grid-2" style="font-size: 0.875rem; gap: 1rem; margin-bottom: 1.5rem;">
        <div>
          <span style="color: var(--text-muted); font-size: 0.75rem; display: block;">NAME</span>
          <strong><%= enquiry.name %></strong>
        </div>
        <div>
          <span style="color: var(--text-muted); font-size: 0.75rem; display: block;">EMAIL</span>
          <a href="mailto:<%= enquiry.email %>" style="color: var(--accent-blue);"><%= enquiry.email %></a>
        </div>
        <div>
          <span style="color: var(--text-muted); font-size: 0.75rem; display: block;">PHONE</span>
          <strong><%= enquiry.phone %></strong>
        </div>
        <div>
          <span style="color: var(--text-muted); font-size: 0.75rem; display: block;">DATE SUBMITTED</span>
          <span><%= formatDate(enquiry.createdAt) %></span>
        </div>
      </div>

      <div style="margin-bottom: 1.5rem;">
        <span style="color: var(--text-muted); font-size: 0.75rem; display: block; margin-bottom: 0.5rem;">MESSAGE CONTENT</span>
        <div style="background-color: var(--bg-subtle); padding: 1.25rem; border-radius: var(--radius-sm); line-height: 1.7; font-size: 0.9375rem;">
          <%= enquiry.message %>
        </div>
      </div>

      <% if (enquiry.adminNotes) { %>
        <div>
          <span style="color: var(--text-muted); font-size: 0.75rem; display: block; margin-bottom: 0.25rem;">INTERNAL ADMIN NOTES</span>
          <div style="font-size: 0.875rem; color: var(--text-secondary); background-color: #eff6ff; padding: 0.75rem; border-radius: var(--radius-sm); border-left: 3px solid var(--accent-blue);">
            <%= enquiry.adminNotes %>
          </div>
        </div>
      <% } %>
    </div>
  </div>

  <aside>
    <div class="card" style="padding: 2rem; border: 2px solid #000000;">
      <h3 style="font-size: 1.25rem; margin-bottom: 1.25rem;">Update Inquiry Status</h3>
      <form action="/admin/enquiries/<%= enquiry._id %>/status" method="POST">
        <div class="form-group">
          <label class="form-label" for="inqStatus">Status</label>
          <select name="status" id="inqStatus" class="form-select">
            <option value="NEW" <%= enquiry.status === 'NEW' ? 'selected' : '' %>>NEW</option>
            <option value="CONTACTED" <%= enquiry.status === 'CONTACTED' ? 'selected' : '' %>>CONTACTED</option>
            <option value="RESOLVED" <%= enquiry.status === 'RESOLVED' ? 'selected' : '' %>>RESOLVED</option>
            <option value="ARCHIVED" <%= enquiry.status === 'ARCHIVED' ? 'selected' : '' %>>ARCHIVED</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="notes">Resolution Notes</label>
          <textarea id="notes" name="adminNotes" class="form-textarea" rows="3" placeholder="Call summary, follow-up date..."><%= enquiry.adminNotes || '' %></textarea>
        </div>

        <button type="submit" class="btn btn-primary btn-full">Save Changes &rarr;</button>
      </form>
    </div>
  </aside>
</div>
