<div style="margin-bottom: 2rem;">
  <div style="font-family: var(--font-mono); font-size: 0.8125rem; color: var(--text-muted); margin-bottom: 0.5rem;">
    <a href="/admin/projects">Projects</a> / <span style="color: var(--text-primary);"><%= isEdit ? `Edit: ${project.title}` : 'New Project' %></span>
  </div>
  <h2 style="font-size: 1.75rem;"><%= isEdit ? `Edit Project: ${project.title}` : 'Add Student Project' %></h2>
</div>

<div class="card" style="padding: 2.5rem; max-width: 860px;">
  <form action="<%= isEdit ? `/admin/projects/${project._id}` : '/admin/projects' %>" method="POST">
    <div class="form-row">
      <div class="form-group">
        <label class="form-label" for="projTitle">Project Title <span class="required">*</span></label>
        <input type="text" id="projTitle" name="title" class="form-control" placeholder="e.g. NovaKV: Distributed Raft Engine" required value="<%= project.title || '' %>">
      </div>

      <div class="form-group">
        <label class="form-label" for="projSlug">URL Slug</label>
        <input type="text" id="projSlug" name="slug" class="form-control" placeholder="novakv-distributed-raft-engine" value="<%= project.slug || '' %>">
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label class="form-label" for="category">Category <span class="required">*</span></label>
        <select name="category" id="category" class="form-select">
          <option value="AI" <%= project.category === 'AI' ? 'selected' : '' %>>AI / Machine Learning</option>
          <option value="WEB" <%= project.category === 'WEB' ? 'selected' : '' %>>Web Systems</option>
          <option value="MOBILE" <%= project.category === 'MOBILE' ? 'selected' : '' %>>Mobile / Edge</option>
          <option value="ROBOTICS" <%= project.category === 'ROBOTICS' ? 'selected' : '' %>>Robotics & Hardware</option>
          <option value="STARTUP" <%= project.category === 'STARTUP' ? 'selected' : '' %>>Venture Startup</option>
          <option value="OPEN SOURCE" <%= project.category === 'OPEN SOURCE' || project.category === 'OPEN_SOURCE' ? 'selected' : '' %>>Open Source</option>
        </select>
      </div>

      <div class="form-group">
        <label class="form-label" for="year">Undergraduate Year</label>
        <select name="year" id="year" class="form-select">
          <option value="1" <%= project.year === 1 ? 'selected' : '' %>>Year 1</option>
          <option value="2" <%= project.year === 2 ? 'selected' : '' %>>Year 2</option>
          <option value="3" <%= project.year === 3 ? 'selected' : '' %>>Year 3</option>
          <option value="4" <%= project.year === 4 ? 'selected' : '' %>>Year 4</option>
        </select>
      </div>
    </div>

    <div class="form-group">
      <label class="form-label" for="projTagline">Tagline / One-liner</label>
      <input type="text" id="projTagline" name="tagline" class="form-control" placeholder="Sub-millisecond in-memory engine" value="<%= project.tagline || '' %>">
    </div>

    <div class="form-group">
      <label class="form-label" for="projDesc">Full Case Study Description <span class="required">*</span></label>
      <textarea id="projDesc" name="description" class="form-textarea" rows="4" required><%= project.description || '' %></textarea>
    </div>

    <div class="form-group">
      <label class="form-label" for="tech">Technologies Used (Comma-separated)</label>
      <input type="text" id="tech" name="technology" class="form-control" placeholder="Rust, Tokio, Raft, Docker, PyTorch" value="<%= project.technology ? project.technology.join(', ') : '' %>">
    </div>

    <div class="form-row">
      <div class="form-group">
        <label class="form-label" for="githubUrl">GitHub Repository URL</label>
        <input type="url" id="githubUrl" name="githubUrl" class="form-control" placeholder="https://github.com/..." value="<%= project.githubUrl || '' %>">
      </div>

      <div class="form-group">
        <label class="form-label" for="liveUrl">Live App / Demo URL</label>
        <input type="url" id="liveUrl" name="liveUrl" class="form-control" placeholder="https://..." value="<%= project.liveUrl || '' %>">
      </div>
    </div>

    <div class="form-group">
      <label class="form-label" for="thumbnail">Thumbnail Image URL</label>
      <input type="url" id="thumbnail" name="thumbnail" class="form-control" placeholder="https://images.unsplash.com/..." value="<%= project.thumbnail || '' %>">
    </div>

    <div class="form-check" style="margin-top: 1rem;">
      <input type="checkbox" name="featured" id="featured" class="form-check-input" <%= project.featured ? 'checked' : '' %>>
      <label for="featured" class="form-check-label">Featured on Homepage Showcase</label>
    </div>

    <div style="display: flex; gap: 1rem; margin-top: 1.5rem;">
      <button type="submit" class="btn btn-primary"><%= isEdit ? 'Update Project' : 'Add Project' %> &rarr;</button>
      <a href="/admin/projects" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</div>
