<div class="section-sm" style="background-color: var(--bg-surface); border-bottom: 1px solid var(--border-light);">
  <div class="container">
    <div style="font-family: var(--font-mono); font-size: 0.8125rem; color: var(--text-muted); margin-bottom: 0.75rem;">
      <a href="/">Home</a> / <a href="/projects">Projects</a> / <span style="color: var(--text-primary);"><%= project.title %></span>
    </div>

    <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem;">
      <span class="badge badge-accent"><%= project.category %></span>
      <span class="pill-tag">Year <%= project.year %> Capstone</span>
      <% if (project.stats && project.stats.highlight) { %>
        <span class="badge badge-success"><%= project.stats.highlight %></span>
      <% } %>
    </div>

    <h1 style="font-size: clamp(2.25rem, 4.5vw, 3.25rem); margin-bottom: 0.75rem;"><%= project.title %></h1>
    <p class="lead" style="max-width: 820px; margin-bottom: 2rem;"><%= project.tagline || project.description %></p>

    <div style="display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;">
      <% if (project.liveUrl) { %>
        <a href="<%= project.liveUrl %>" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">Live Demo / Product ↗</a>
      <% } %>
      <% if (project.githubUrl) { %>
        <a href="<%= project.githubUrl %>" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-lg">View Source on GitHub ↗</a>
      <% } %>
      <% if (isAuthenticated && isStudent) { %>
        <button type="button" class="btn btn-secondary" data-bookmark-btn data-item-type="project" data-item-id="<%= project._id %>">
          ★ Save Project
        </button>
      <% } %>
    </div>
  </div>
</div>

<div class="section">
  <div class="container">
    <div class="grid grid-2-1" style="gap: 3rem; align-items: start;">
      <div>
        <img src="<%= project.thumbnail || 'https://images.unsplash.com/photo-1558494949-ef010cbdcc31?auto=format&fit=crop&w=800&q=80' %>" alt="<%= project.title %>" style="width: 100%; border-radius: var(--radius-md); margin-bottom: 2.5rem; height: 380px; object-fit: cover;" loading="lazy">

        <!-- Case Study Description -->
        <div style="margin-bottom: 3rem;">
          <h2 style="font-size: 1.75rem; margin-bottom: 1rem;">Project Overview</h2>
          <p style="font-size: 1.0625rem; color: var(--text-secondary); line-height: 1.7;">
            <%= project.description %>
          </p>
        </div>

        <!-- Problem Statement -->
        <% if (project.problemStatement) { %>
          <div style="margin-bottom: 3rem;">
            <h2 style="font-size: 1.75rem; margin-bottom: 1rem;">The Engineering Challenge</h2>
            <div class="card" style="background-color: var(--bg-surface); border-left: 3px solid var(--brand-rose); padding: 1.5rem;">
              <p style="font-size: 1rem; color: var(--text-primary); line-height: 1.6;">
                <%= project.problemStatement %>
              </p>
            </div>
          </div>
        <% } %>

        <!-- Solution & Architecture -->
        <% if (project.solutionArchitecture) { %>
          <div style="margin-bottom: 3rem;">
            <h2 style="font-size: 1.75rem; margin-bottom: 1rem;">System Architecture & Design Decisions</h2>
            <div class="card" style="background-color: var(--bg-surface); border-left: 3px solid var(--brand-emerald); padding: 1.5rem;">
              <p style="font-size: 1rem; color: var(--text-primary); line-height: 1.6;">
                <%= project.solutionArchitecture %>
              </p>
            </div>
          </div>
        <% } %>

        <!-- Tech Stack -->
        <div style="margin-bottom: 3rem;">
          <h2 style="font-size: 1.75rem; margin-bottom: 1.25rem;">Technologies Used</h2>
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
            <% if (project.technology && project.technology.length > 0) { %>
              <% project.technology.forEach(tech => { %>
                <span class="pill-tag" style="padding: 0.5rem 1rem; font-size: 0.875rem; font-weight: 600;"><%= tech %></span>
              <% }) %>
            <% } %>
          </div>
        </div>

        <!-- Student Authors -->
        <% if (project.students && project.students.length > 0) { %>
          <div style="margin-bottom: 3rem;">
            <h2 style="font-size: 1.75rem; margin-bottom: 1.25rem;">Student Engineering Team</h2>
            <div class="grid grid-2">
              <% project.students.forEach(student => { %>
                <div class="card" style="padding: 1.5rem;">
                  <h4 style="margin-bottom: 0.25rem;"><%= student.name %></h4>
                  <div style="font-family: var(--font-mono); font-size: 0.8125rem; color: var(--accent-blue); margin-bottom: 0.5rem;"><%= student.role %></div>
                  <div style="font-size: 0.8125rem; color: var(--text-muted);"><%= student.batch %></div>
                  <% if (student.github) { %>
                    <a href="<%= student.github %>" target="_blank" rel="noopener noreferrer" style="display: inline-block; margin-top: 0.75rem; font-size: 0.8125rem; color: var(--text-secondary); text-decoration: underline;">GitHub Profile ↗</a>
                  <% } %>
                </div>
              <% }) %>
            </div>
          </div>
        <% } %>

        <!-- Related Projects -->
        <% if (relatedProjects && relatedProjects.length > 0) { %>
          <div>
            <h2 style="font-size: 1.75rem; margin-bottom: 1.25rem;">Similar Student Projects</h2>
            <div class="grid grid-3">
              <% relatedProjects.forEach(p => { %>
                <%- include('../partials/projectCard', { project: p }) %>
              <% }) %>
            </div>
          </div>
        <% } %>
      </div>

      <!-- Project Metadata Sidebar -->
      <aside>
        <div class="card" style="position: sticky; top: 6rem; padding: 2rem;">
          <h3 style="font-size: 1.35rem; margin-bottom: 1.25rem;">Project Metadata</h3>

          <div style="display: flex; flex-direction: column; gap: 1.25rem; font-size: 0.875rem; margin-bottom: 1.5rem;">
            <div>
              <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted);">CATEGORY</div>
              <div style="font-weight: 700; color: var(--text-primary); margin-top: 0.25rem;"><%= project.category %></div>
            </div>

            <div>
              <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted);">ACADEMIC STAGE</div>
              <div style="color: var(--text-primary); margin-top: 0.25rem;">Year <%= project.year %> Undergraduate Sprint</div>
            </div>

            <% if (project.stats && project.stats.metricLabel) { %>
              <div>
                <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted);">IMPACT / TRACTION</div>
                <div style="font-weight: 600; color: var(--brand-emerald); margin-top: 0.25rem;"><%= project.stats.metricLabel %></div>
              </div>
            <% } %>

            <% if (project.program) { %>
              <div>
                <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted);">DEGREE TRACK</div>
                <div style="margin-top: 0.25rem;">
                  <a href="/programs/<%= project.program.slug %>" style="color: var(--accent-blue); font-weight: 600;"><%= project.program.name %> &rarr;</a>
                </div>
              </div>
            <% } %>
          </div>

          <div style="display: flex; flex-direction: column; gap: 0.75rem;">
            <% if (project.liveUrl) { %>
              <a href="<%= project.liveUrl %>" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-full">Launch Live App ↗</a>
            <% } %>
            <% if (project.githubUrl) { %>
              <a href="<%= project.githubUrl %>" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-full">Source Code ↗</a>
            <% } %>
            <a href="/student/application" class="btn btn-secondary btn-full">Apply to Build at NOVA</a>
          </div>
        </div>
      </aside>
    </div>
  </div>
</div>
