<div class="section-sm" style="background-color: var(--bg-surface); border-bottom: 1px solid var(--border-light);">
  <div class="container">
    <div style="font-family: var(--font-mono); font-size: 0.8125rem; color: var(--text-muted); margin-bottom: 0.5rem;">
      <a href="/">Home</a> / <span style="color: var(--text-primary);">Industry Mentors & Faculty</span>
    </div>
    <h1 style="font-size: 2.75rem; margin-bottom: 0.75rem;">Mentors & Faculty Directory</h1>
    <p class="lead" style="max-width: 780px;">
      Learn directly from Staff Engineers, AI Researchers, and Unicorn Founders from Google DeepMind, OpenAI, NVIDIA, Stripe, and beyond.
    </p>
    <div class="alert alert-info" style="margin-top: 1rem; font-size: 0.8125rem;">
      <strong>Directory Notice:</strong> Example mentor profiles — demo data for educational platform illustration.
    </div>

    <!-- Filter & Search -->
    <form action="/mentors" method="GET" style="margin-top: 2rem; display: flex; gap: 1rem; flex-wrap: wrap;">
      <div style="flex: 1; min-width: 260px;">
        <input type="text" name="search" class="form-control" placeholder="Search by name, company, or specialty..." value="<%= searchQuery %>">
      </div>

      <div style="width: 240px;">
        <select name="expertise" class="form-select" onchange="this.form.submit()">
          <option value="all" <%= currentExpertise === 'all' ? 'selected' : '' %>>All Specialties</option>
          <% expertiseList.forEach(exp => { %>
            <option value="<%= exp %>" <%= currentExpertise === exp ? 'selected' : '' %>><%= exp %></option>
          <% }) %>
        </select>
      </div>

      <button type="submit" class="btn btn-primary">Filter</button>
      <% if (searchQuery || currentExpertise !== 'all') { %>
        <a href="/mentors" class="btn btn-secondary">Reset</a>
      <% } %>
    </form>
  </div>
</div>

<div class="section">
  <div class="container">
    <% if (mentors && mentors.length > 0) { %>
      <div class="grid grid-3">
        <% mentors.forEach(mentor => { %>
          <%- include('../partials/mentorCard', { mentor }) %>
        <% }) %>
      </div>
    <% } else { %>
      <div class="card text-center" style="padding: 4rem;">
        <h3>No mentors match your filter</h3>
        <p style="color: var(--text-secondary); margin: 0.5rem 0 1.5rem;">Try choosing a different expertise area or clearing your search term.</p>
        <a href="/mentors" class="btn btn-primary">View All Mentors</a>
      </div>
    <% } %>
  </div>
</div>
