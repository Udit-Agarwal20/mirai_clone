<div class="section-sm" style="background-color: var(--bg-surface); border-bottom: 1px solid var(--border-light);">
  <div class="container">
    <div style="font-family: var(--font-mono); font-size: 0.8125rem; color: var(--text-muted); margin-bottom: 0.75rem;">
      <a href="/">Home</a> / <a href="/programs">Programs</a> / <span style="color: var(--text-primary);"><%= program.name %></span>
    </div>

    <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem;">
      <span class="badge badge-accent"><%= program.badge || 'AI-First B.Tech' %></span>
      <span class="pill-tag"><%= program.duration %></span>
      <span class="pill-tag"><%= program.seatsTotal %> Seats Total</span>
    </div>

    <h1 style="font-size: clamp(2.25rem, 4.5vw, 3.25rem); margin-bottom: 0.75rem;"><%= program.name %></h1>
    <p class="lead" style="max-width: 820px; margin-bottom: 2rem;"><%= program.tagline || program.shortDescription %></p>

    <div style="display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;">
      <a href="/student/application" class="btn btn-primary btn-lg">Apply for this Program &rarr;</a>
      <a href="/fees?programId=<%= program._id %>" class="btn btn-secondary btn-lg">Calculate 4-Year Cost</a>
      <% if (isAuthenticated && isStudent) { %>
        <button type="button" class="btn btn-secondary" data-bookmark-btn data-item-type="program" data-item-id="<%= program._id %>">
          ★ Save Program
        </button>
      <% } %>
    </div>
  </div>
</div>

<div class="section">
  <div class="container">
    <div class="grid grid-2-1" style="gap: 3rem; align-items: start;">
      <div>
        <!-- Program Overview -->
        <div style="margin-bottom: 3.5rem;">
          <h2 style="font-size: 1.75rem; margin-bottom: 1rem;">Program Overview</h2>
          <p style="font-size: 1.0625rem; color: var(--text-secondary); line-height: 1.7;">
            <%= program.description %>
          </p>
        </div>

        <!-- Who Should Choose This -->
        <% if (program.whoShouldChoose && program.whoShouldChoose.length > 0) { %>
          <div style="margin-bottom: 3.5rem;">
            <h2 style="font-size: 1.75rem; margin-bottom: 1.25rem;">Who Should Choose This Program</h2>
            <div style="display: flex; flex-direction: column; gap: 0.75rem;">
              <% program.whoShouldChoose.forEach(item => { %>
                <div class="card" style="padding: 1.25rem; background-color: var(--bg-surface); border-left: 3px solid var(--accent-blue);">
                  <div style="font-size: 0.9375rem; color: var(--text-primary); font-weight: 500;">✓ <%= item %></div>
                </div>
              <% }) %>
            </div>
          </div>
        <% } %>

        <!-- Core Skills -->
        <div style="margin-bottom: 3.5rem;">
          <h2 style="font-size: 1.75rem; margin-bottom: 1.25rem;">Technical Stack & Skills Mastered</h2>
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
            <% if (program.skills && program.skills.length > 0) { %>
              <% program.skills.forEach(skill => { %>
                <span class="pill-tag" style="padding: 0.5rem 1rem; font-size: 0.875rem; font-weight: 600;"><%= skill %></span>
              <% }) %>
            <% } %>
          </div>
        </div>

        <!-- 4-Year Year-Wise Curriculum -->
        <div style="margin-bottom: 3.5rem;">
          <h2 style="font-size: 1.75rem; margin-bottom: 1.5rem;">4-Year Build-First Curriculum</h2>
          
          <div style="display: flex; flex-direction: column; gap: 1.5rem;">
            <% if (program.yearWiseCurriculum && program.yearWiseCurriculum.length > 0) { %>
              <% program.yearWiseCurriculum.forEach(yearPlan => { %>
                <div class="card" style="padding: 2rem;">
                  <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.5rem;">
                    <span class="badge badge-accent">Year 0<%= yearPlan.year %></span>
                    <span style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted);"><%= yearPlan.theme %></span>
                  </div>

                  <h3 style="font-size: 1.35rem; margin-bottom: 0.75rem;"><%= yearPlan.title %></h3>
                  <p style="font-size: 0.875rem; color: var(--text-secondary); margin-bottom: 1.25rem;"><%= yearPlan.focus %></p>

                  <div style="margin-bottom: 1rem;">
                    <div style="font-family: var(--font-mono); font-size: 0.75rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.5rem;">KEY COURSES</div>
                    <ul style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0.5rem; font-size: 0.8125rem; color: var(--text-secondary);">
                      <% yearPlan.courses.forEach(course => { %>
                        <li>• <%= course %></li>
                      <% }) %>
                    </ul>
                  </div>

                  <div style="background-color: var(--bg-subtle); border-radius: var(--radius-sm); padding: 1rem; margin-top: 1rem;">
                    <div style="font-family: var(--font-mono); font-size: 0.75rem; font-weight: 700; color: var(--accent-blue); margin-bottom: 0.25rem;">CAPSTONE PROJECT DELIVERABLE</div>
                    <% yearPlan.projects.forEach(p => { %>
                      <div style="font-size: 0.875rem; font-weight: 600; color: var(--text-primary);">⚡ <%= p %></div>
                    <% }) %>
                  </div>
                </div>
              <% }) %>
            <% } %>
          </div>
        </div>

        <!-- Career Paths -->
        <% if (program.careerPaths && program.careerPaths.length > 0) { %>
          <div style="margin-bottom: 3.5rem;">
            <h2 style="font-size: 1.75rem; margin-bottom: 1.25rem;">Career Outcomes & Starting Packages</h2>
            <div class="grid grid-2">
              <% program.careerPaths.forEach(path => { %>
                <div class="card" style="padding: 1.5rem;">
                  <h4 style="margin-bottom: 0.25rem;"><%= path.role %></h4>
                  <div style="font-family: var(--font-mono); font-size: 0.9375rem; font-weight: 700; color: var(--brand-emerald); margin-bottom: 0.75rem;">
                    <%= path.avgSalary %>
                  </div>
                  <p style="font-size: 0.8125rem; color: var(--text-secondary); margin-bottom: 1rem;"><%= path.description %></p>
                  
                  <div style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-muted); margin-bottom: 0.25rem;">TOP HIRING COMPANIES</div>
                  <div style="display: flex; flex-wrap: wrap; gap: 0.35rem;">
                    <% path.topHiringCompanies.forEach(comp => { %>
                      <span class="pill-tag" style="font-size: 0.6875rem;"><%= comp %></span>
                    <% }) %>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>
        <% } %>

        <!-- Associated Student Projects -->
        <% if (projects && projects.length > 0) { %>
          <div>
            <h2 style="font-size: 1.75rem; margin-bottom: 1.25rem;">Projects Built in This Program</h2>
            <div class="grid grid-2">
              <% projects.forEach(project => { %>
                <%- include('../partials/projectCard', { project }) %>
              <% }) %>
            </div>
          </div>
        <% } %>
      </div>

      <!-- Right Sticky Sidebar -->
      <aside>
        <div class="card" style="position: sticky; top: 6rem; padding: 2rem;">
          <h3 style="font-size: 1.35rem; margin-bottom: 1.25rem;">Admissions & Fee Summary</h3>

          <div style="display: flex; flex-direction: column; gap: 1rem; margin-bottom: 1.5rem;">
            <div>
              <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted);">ANNUAL TUITION</div>
              <div style="font-family: var(--font-mono); font-size: 1.5rem; font-weight: 800; color: var(--text-primary);">
                <%= formatCurrency(program.fees.tuitionPerYear) %>
                <span style="font-size: 0.8125rem; font-weight: 400; color: var(--text-muted);">/ year</span>
              </div>
            </div>

            <div>
              <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted);">ONE-TIME REGISTRATION</div>
              <div style="font-family: var(--font-mono); font-size: 1rem; font-weight: 600;"><%= formatCurrency(program.fees.oneTimeAdmissionFee) %></div>
            </div>

            <div>
              <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted);">AVAILABLE CAMPUSES</div>
              <div style="display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 0.25rem;">
                <% if (program.campuses && program.campuses.length > 0) { %>
                  <% program.campuses.forEach(c => { %>
                    <span class="pill-tag"><%= c.city %></span>
                  <% }) %>
                <% } else { %>
                  <span class="pill-tag">Bengaluru</span>
                  <span class="pill-tag">Hyderabad</span>
                  <span class="pill-tag">Pune</span>
                <% } %>
              </div>
            </div>
          </div>

          <div style="background-color: var(--accent-light); border: 1px solid rgba(37,99,235,0.2); border-radius: var(--radius-sm); padding: 1rem; margin-bottom: 1.5rem;">
            <div style="font-weight: 700; font-size: 0.875rem; color: var(--accent-blue); margin-bottom: 0.25rem;">Scholarships Available</div>
            <div style="font-size: 0.8125rem; color: var(--text-secondary);">Up to 100% tuition waiver through Founders Merit Fellowship.</div>
          </div>

          <div style="display: flex; flex-direction: column; gap: 0.75rem;">
            <a href="/student/application" class="btn btn-primary btn-full">Apply For This Degree &rarr;</a>
            <a href="/fees?programId=<%= program._id %>" class="btn btn-secondary btn-full">Detailed Fee Calculator</a>
            <a href="/career-planner" class="btn btn-secondary btn-full">Custom Career Roadmap</a>
          </div>
        </div>
      </aside>
    </div>
  </div>
</div>
